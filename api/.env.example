# Copy to api/.env for local development. .env is gitignored — never commit real
# values. These are read at RUNTIME via process.env.
#
# In the cluster the same names come from the `tylerpedersen-api-env` Secret,
# which the deploy workflow builds from GitHub Secrets/Variables and injects via
# envFrom in k8s/api-deployment.yaml.

# Port the api listens on. The container and probes assume 3000.
PORT=3000

# CoinGecko base URL. Not sensitive — set in GitHub as an Actions *variable*
# (vars.COINGECKO_API_URL). Demo and Pro are different hosts.
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# CoinGecko API key. Sensitive — set in GitHub as an Actions *secret*
# (secrets.COINGECKO_API_KEY). Leave blank to use the unauthenticated tier.
COINGECKO_API_KEY=
